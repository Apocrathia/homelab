iSCSILUNDiskLatencyAvg OBJECT-TYPE
	SYNTAX		Integer32
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION	"Average latency of LUN disk"
	::= { iSCSILUNEntry 18 }

iSCSILUNThinProvisionVolFreeMBs OBJECT-TYPE
	SYNTAX		Integer32
	MAX-ACCESS	read-only
	STATUS		current
	DESCRIPTION	"Free space(MB) of thin provisioning lun's volume"
	::= { iSCSILUNEntry 19 }

