    {
      "datasource": {
        "type": "prometheus",
        "uid": "${mimir}"
      },
      "description": "Green 'reporting' = the pipeline pushed metrics within the trailing 3m (10s push cadence). Rows are generated dynamically: every pipeline with samples in the dashboard range gets a lane \u2014 nothing is pinned, so new and renamed pipelines appear without dashboard changes. A pipeline that stops reporting mid-range shows a gap in its lane (red segments appear up to 3m late \u2014 the staleness window). The unnamed red DOWN lane is the all-down guard: it appears only when NO pipeline pushed samples in the trailing 3m (the guard arm yields nothing whenever any lane reports, so it never pollutes the per-pipeline rows) \u2014 one red row instead of a blank panel. Residual limit: a pipeline absent longer than the dashboard range renders no lane at all (PromQL cannot enumerate nonexistent series) \u2014 node-level absence is caught by the guard lane and the metric/stdout panels.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "reporting"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${mimir}"
          },
          "editorMode": "code",
          "expr": "count_over_time(tenzir_pipeline_ingress_events[3m]) > bool 0 or (1 - absent_over_time(tenzir_pipeline_ingress_events[3m]))",
          "legendFormat": "{{pipeline_name}}",
          "queryType": "instant",
          "refId": "A"
        }
