---
args:
  named:
    - name: service
      type: string
      default: "tetragon-export"
---

// Filter the OTLP stream down to the tetragon alloy's events and unpack
// the JSON export body. The event itself carries node_name, so unlike the
// kube-audit parse no node attribute needs merging; pivots run on the
// OCSF record (no raw stream lands in Loki).
where body.kind == "string"
where resource.attributes["service.name"] == $service
this = parse_json(body.string_value)
