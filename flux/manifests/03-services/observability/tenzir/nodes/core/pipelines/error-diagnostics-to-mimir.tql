diagnostics live=true
fork {
  where severity == "error"
  to_prometheus "http://mimir-gateway.mimir-system.svc:80/api/v1/push",
    name="tenzir_pipeline_errors",
    value=1,
    timestamp=timestamp,
    labels={pipeline_id: pipeline_id, pipeline_name: pipeline_name, node: "core"}
}
where severity == "warning"
to_prometheus "http://mimir-gateway.mimir-system.svc:80/api/v1/push",
  name="tenzir_pipeline_warnings",
  value=1,
  timestamp=timestamp,
  labels={pipeline_id: pipeline_id, pipeline_name: pipeline_name, node: "core"}
