{
  "_id": "custom_01_input",
  "name": "01 - Input and Validation",
  "description": "Entry point. File validation, codec detection, resolution tagging, and skip logic.",
  "tags": "",
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "inputsDB": {
        "fileAccessChecks": "true"
      },
      "id": "inp001",
      "position": { "x": 400, "y": 0 },
      "fpEnabled": true
    },
    {
      "name": "File size check (10MB - 200GB)",
      "sourceRepo": "Community",
      "pluginName": "runClassicTranscodePlugin",
      "version": "2.0.0",
      "inputsDB": {
        "pluginSourceId": "Community:Tdarr_Plugin_a9he_New_file_size_check",
        "lowerBound": "0.01",
        "upperBound": "200"
      },
      "id": "inp002",
      "position": { "x": 400, "y": 100 },
      "fpEnabled": true
    },
    {
      "name": "Is video codec HEVC?",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "inputsDB": {
        "codec": "hevc"
      },
      "id": "inp003",
      "position": { "x": 400, "y": 250 },
      "fpEnabled": true
    },
    {
      "name": "Not HEVC - needs transcode",
      "sourceRepo": "Community",
      "pluginName": "setFlowVariable",
      "version": "1.0.0",
      "inputsDB": {
        "variable": "needs_transcode",
        "value": "true"
      },
      "id": "inp004",
      "position": { "x": 200, "y": 350 },
      "fpEnabled": true
    },
    {
      "name": "HEVC - check resolution for bitrate thresholds",
      "sourceRepo": "Community",
      "pluginName": "checkVideoResolution",
      "version": "1.0.0",
      "id": "inp005",
      "position": { "x": 600, "y": 350 },
      "fpEnabled": true
    },
    {
      "name": "720p or below: bitrate < 4 Mbps?",
      "sourceRepo": "Community",
      "pluginName": "checkVideoBitrate",
      "version": "1.0.0",
      "inputsDB": {
        "lessThan": "4",
        "unit": "mbps"
      },
      "id": "inp006",
      "position": { "x": 300, "y": 500 },
      "fpEnabled": true
    },
    {
      "name": "1080p: bitrate < 10 Mbps?",
      "sourceRepo": "Community",
      "pluginName": "checkVideoBitrate",
      "version": "1.0.0",
      "inputsDB": {
        "lessThan": "10",
        "unit": "mbps"
      },
      "id": "inp007",
      "position": { "x": 600, "y": 500 },
      "fpEnabled": true
    },
    {
      "name": "4K: bitrate < 25 Mbps?",
      "sourceRepo": "Community",
      "pluginName": "checkVideoBitrate",
      "version": "1.0.0",
      "inputsDB": {
        "lessThan": "25",
        "unit": "mbps"
      },
      "id": "inp008",
      "position": { "x": 900, "y": 500 },
      "fpEnabled": true
    },
    {
      "name": "HEVC bitrate OK - skip",
      "sourceRepo": "Community",
      "pluginName": "comment",
      "version": "1.0.0",
      "id": "inp009",
      "position": { "x": 600, "y": 650 },
      "fpEnabled": true
    },
    {
      "name": "HEVC bitrate too high - needs transcode",
      "sourceRepo": "Community",
      "pluginName": "setFlowVariable",
      "version": "1.0.0",
      "inputsDB": {
        "variable": "needs_transcode",
        "value": "true"
      },
      "id": "inp010",
      "position": { "x": 200, "y": 650 },
      "fpEnabled": true
    },
    {
      "name": "Go to Audio flow",
      "sourceRepo": "Community",
      "pluginName": "goToFlow",
      "version": "2.0.0",
      "inputsDB": {
        "flowId": "custom_02_audio"
      },
      "id": "inp011",
      "position": { "x": 200, "y": 800 },
      "fpEnabled": true
    }
  ],
