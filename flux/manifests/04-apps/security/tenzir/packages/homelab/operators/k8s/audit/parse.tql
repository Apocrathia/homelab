---
args:
  named:
    - name: service
      type: string
      default: "kube-apiserver-audit"
---

// Filter the OTLP stream down to kube-apiserver audit lines and unpack the
// JSON body into the raw audit event.
where body.kind == "string"
where resource.attributes["service.name"] == $service
this = parse_json(body.string_value)
