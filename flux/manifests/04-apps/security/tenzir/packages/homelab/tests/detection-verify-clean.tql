---
pre-compare: sort
---
from_file env("TENZIR_INPUT") {
  read_json
}
// The stored-shape records exactly as the live lane reads them back:
// the attest test's output as strict JSON — what the per-class ocsf
// catch-all columns hold, minus the schema-unification null paddings
// (att[0].prev_event / att[1].fingerprint), which the ClickHouse
// JSON-column write drops anyway. The chain: API Activity a1 ->
// API Activity a2 (same second, uid-ordered) -> Authentication ->
// API Activity -> Detection Finding, one chain per node
// (chain_uid = tenzir-node-core), links riding attestation_list[1]
// (the un-hashed chain-link attestation; attestation_list[0] is the
// record fingerprint). Expected: the summary line alone — every
// record walks silently, zero findings.
fork {
  summarize records_checked = count()
  to_stdout { write_json }
}
homelab::record_integrity::verify product="homelab-detection",
  title="Detection record chain break",
  uid_prefix="detection",
  scope_word="chain",
  windowed=true,
  link="stream"
