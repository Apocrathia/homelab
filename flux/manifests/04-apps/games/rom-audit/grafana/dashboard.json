{
  "annotations": {
    "list": []
  },
  "description": "rom-audit CronJob NDJSON via Alloy \u2192 Loki. Pin container_runtime=containerd; run_summary stats use max(max by (pod) (...)) so a full CronJob wins over one-shots. Default range 30d.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Largest run_summary per field in range (max by pod, then max). Full CronJob dominates small one-shots.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "matched"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "unknown"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "wrong_name"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "total"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "max(max by (pod) (last_over_time({namespace=\"rom-audit\", container=\"rom-audit\"} | json | event=\"run_summary\" | unwrap matched [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "legendFormat": "matched"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "max(max by (pod) (last_over_time({namespace=\"rom-audit\", container=\"rom-audit\"} | json | event=\"run_summary\" | unwrap unknown [$__range])))",
          "queryType": "instant",
          "refId": "B",
          "legendFormat": "unknown"
