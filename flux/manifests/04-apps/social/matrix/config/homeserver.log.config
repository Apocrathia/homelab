# Synapse log config - docs/sample_log_config.yaml with the console
# handler only: container logs belong in kubectl logs, not on the
# PVC-backed /data. Rendered to /data/matrix.apocrathia.com.log.config by
# the render-config init container.
version: 1

formatters:
    precise:
        format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
    console:
        class: logging.StreamHandler
        formatter: precise

loggers:
    synapse.storage.SQL:
        # beware: increasing this to DEBUG makes synapse log sensitive
        # information such as access tokens.
        level: INFO

root:
    level: INFO
    handlers: [console]

disable_existing_loggers: false
