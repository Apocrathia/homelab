---
extends: default

# Match pre-commit yamllint exclude (Helm templates are not valid YAML).
# Skip local agent scratch / worktree dirs so `yamllint .` stays usable.
ignore: |
  helm/**/templates/*.yaml
  .scratch/**
  .worktrees/**

rules:
  line-length:
    max: 256
    level: warning
    ignore: |
      flux/manifests/01-bootstrap/flux-system/*
      helm/**/templates/*.yaml
      # Vendored SigmaHQ rule files are upstream bytes; one rule's
      # description block exceeds the 256-char limit.
      flux/manifests/04-apps/security/tenzir/detections/sigma/sigmahq/**
      flux/manifests/04-apps/security/tenzir/detections/yara/signature-base/**

  braces:
    level: warning
    ignore: |
      helm/**/templates/*.yaml

  indentation:
    ignore: |
      helm/**/templates/*.yaml
      # Vendored tenzir library `stix` and `tenzir` packages: upstream
      # bytes; their package.yaml puts top-level sequence items at
      # column 1, one level left of our style.
      flux/manifests/04-apps/security/tenzir/packages/stix/**
      flux/manifests/04-apps/security/tenzir/packages/tenzir/**

  empty-lines:
    ignore: |
      # Vendored tenzir library `tenzir` package: upstream bytes; its
      # package.yaml ships one trailing blank line at EOF.
      flux/manifests/04-apps/security/tenzir/packages/tenzir/**

  # Adjust comments spacing rule to be compatible with prettier
  comments:
    min-spaces-from-content: 1  # Default is 2, but prettier uses 1
    level: warning  # Keep as warning instead of disabling completely

  # Other rules remain at their default settings
  document-start:
    present: true
    ignore: |
      helm/**/templates/*.yaml
      # Vendored SigmaHQ rule files are upstream bytes; no document marker.
      flux/manifests/04-apps/security/tenzir/detections/sigma/sigmahq/**
      flux/manifests/04-apps/security/tenzir/detections/yara/signature-base/**
      # Vendored tenzir library `netflow` package: upstream bytes; its
      # package.yaml ships without a document marker.
      flux/manifests/04-apps/security/tenzir/packages/netflow/**
      # Vendored tenzir library `stix` and `tenzir` packages: upstream
      # bytes; their package.yaml / test.yaml files ship without a
      # document marker.
      flux/manifests/04-apps/security/tenzir/packages/stix/**
      flux/manifests/04-apps/security/tenzir/packages/tenzir/**
  document-end: disable
  truthy:
    check-keys: false
