{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "security:openssf-scorecard",
    "docker:pinDigests"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "gitlabci": {
    "enabled": false
  },
  "flux": {
    "enabled": true
  },
  "kubernetes": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchDatasources": ["python-version"],
      "enabled": false
    },
    {
      "matchCategories": ["docker"],
      "enabled": true
    },
    {
      "description": "One MR per digest pin/refresh — override default Pin Dependencies grouping",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": null
    },
    {
      "description": "Base images share one rotation — combine ongoing digest refreshes into one MR",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/^(public\\.ecr\\.aws/)?docker/library/(node|python|alpine|busybox|redis|rabbitmq|ubuntu)$/",
        "/^(node|python|alpine|busybox|redis|rabbitmq|ubuntu)$/"
      ],
      "matchUpdateTypes": ["digest"],
      "groupName": "base image digests"
    },
    {
      "description": "No digest pins for version/tag/imageTag/helper_image fields (nowhere to attach @sha256) or crossplane provider packages (tag@digest unverified in crossplane)",
      "matchDepTypes": ["version-field", "helper-image", "crossplane-provider"],
      "pinDigests": false
    },
    {
      "description": "One MR for all generic-app chart version pins — each new OCI chart tag touches ~122 HelmReleases",
      "matchDatasources": ["docker"],
      "matchDepNames": ["registry.gitlab.com/apocrathia/homelab/generic-app"],
      "groupName": "generic-app chart"
    },
    {
      "description": "MySQL stays on the 8.4 LTS lineage — 26.x needs the 9.x LTS stepping stone (lineage rule) and aborts on an 8.4 datadir",
      "matchPackageNames": ["mysql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "ASF stays on the 6.x lineage — v7 removes plugin APIs (IBotCommand2, Steam.EAccess) that FreePackages 1.7.1.x and ASFFreeGames v1.9.x are built against (TypeLoadException crash loop); lift when both plugins ship ASF-7-compatible releases",
      "matchPackageNames": ["ghcr.io/justarchinet/archisteamfarm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Strict semver only — registry floods non-semver tags (main-*, sha-*, litellm_* branch builds, latest); default docker versioning would chase them",
      "matchPackageNames": ["ghcr.io/berriai/litellm-database"],
      "versioning": "semver"
    },
    {
      "description": "promptfoo init bootstraps modelaudit, whose Requires-Python is <3.15 — pin the base python image to 3.14 or lower so Renovate can't re-drift it past the dep's ceiling",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker/library/python"],
      "matchFileNames": [
        "flux/manifests/04-apps/artificial-intelligence/promptfoo/helmrelease.yaml"
      ],
      "allowedVersions": "<=3.14"
    },
    {
      "description": "bbot 3.0.2 (artex venv) has Requires-Python <3.15 — pin the base python image to 3.14 or lower so Renovate can't re-drift it past the dep's ceiling; lift when bbot moves past a version supporting newer python",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker/library/python"],
      "matchFiles": ["flux/manifests/04-apps/security/artex/helmrelease.yaml"],
      "allowedVersions": "<=3.14"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Renovate comment + image ref (bare, tag, digest, or tag@digest)",
      "managerFilePatterns": [
        "/^flux/manifests/.*\\.ya?ml$/",
        "/^\\.gitlab/.*\\.ya?ml$/",
        "/^fleet/\\.gitlab-ci\\.yml$/",
        "/^ansible/\\.gitlab-ci\\.yml$/"
      ],
      "depTypeTemplate": "image",
      "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}latest{{/if}}",
      "autoReplaceStringTemplate": "{{#if currentDigest}}{{{replace \"DIGEST_PLACEHOLDER\" newDigest (replace currentValue newValue (replace currentDigest \"DIGEST_PLACEHOLDER\" replaceString))}}}{{else}}{{#if (containsString replaceString currentValue)}}{{{replace currentValue newValue replaceString}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{else}}{{{replaceString}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{/if}}{{/if}}",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n(?<indentation>[ \\t]*)(?:image|imageName|baseImage|ateomImage|workerImage):[ \\t]*[\"']?(?:[^\\s\"'@:]+(?:/[^\\s\"'@:]+)*)(?::(?<currentValue>[^\\s\"'@/]+))?(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?",
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n(?<indentation>[ \\t]*)name:[ \\t]*[\"']?(?:[^\\s\"'@:]+/[^\\s\"'@:]+(?:/[^\\s\"'@:]+)*)(?::(?<currentValue>[^\\s\"'@/]+))?(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Renovate comment + plain version (yaml/CI/shell/env-list) or GitHub URL",
      "managerFilePatterns": [
        "/^flux/manifests/.*\\.ya?ml$/",
        "/^\\.gitlab/.*\\.ya?ml$/",
        "/^ansible/.*\\.ya?ml$/"
      ],
      "depTypeTemplate": "version-field",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:- name:\\s+\\S+\\s*\\n\\s+value:\\s*|(?:version|tag|imageTag):\\s*|[A-Z][A-Z0-9_]*[:=]\\s*|[A-Za-z_][\\w.-]*\\s*=\\s*)[\"']?(?<currentValue>[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?",
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*-?\\s*https://(?:github\\.com/[^/]+/[^/]+/releases/download/v|raw\\.githubusercontent\\.com/[^/]+/[^/]+/)(?<currentValue>[^/\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Talos Linux dependencies",
      "managerFilePatterns": ["/^talos/.*\\.yaml$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": [
        "# renovate: datasource=github-releases depName=(?<depName>siderolabs/talos)\\s*\\n\\s*image: .*:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "description": "GitLab Runner helper image in config.toml",
      "managerFilePatterns": [
        "/^flux/manifests/03-services/gitlab/runner/config\\.toml$/"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "helper-image",
      "matchStrings": [
        "# renovate: datasource=docker (?:registryUrl=(?<registryUrl>\\S+) )?depName=(?<depName>\\S+)\\s*\\n\\s*helper_image = [\"'](?:[^:]+:)?(?<currentValue>x86_64-v[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']"
      ],
      "extractVersionTemplate": "^x86_64-v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Docker images in GitLab Runner config.toml",
      "managerFilePatterns": [
        "/^flux/manifests/03-services/gitlab/runner/config\\.toml$/"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image",
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s*\\n\\s*image = [\"'](?:[^:]+):(?<currentValue>[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']"
      ]
    },

    {
      "customType": "regex",
      "description": "Crossplane provider package refs (OCI tags)",
      "managerFilePatterns": [
        "/^flux/manifests/.*\\.ya?ml$/",
        "/^\\.gitlab/.*\\.ya?ml$/"
      ],
      "depTypeTemplate": "crossplane-provider",
      "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}latest{{/if}}",
      "autoReplaceStringTemplate": "{{#if currentDigest}}{{{replace \"DIGEST_PLACEHOLDER\" newDigest (replace currentValue newValue (replace currentDigest \"DIGEST_PLACEHOLDER\" replaceString))}}}{{else}}{{#if (containsString replaceString currentValue)}}{{{replace currentValue newValue replaceString}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{else}}{{{replaceString}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{/if}}{{/if}}",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n(?<indentation>[ \\t]*)package:[ \\t]*[\"']?(?:[^\\s\"'@:]+(?:/[^\\s\"'@:]+)*)(?::(?<currentValue>[^\\s\"'@/]+))?(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?"
      ]
    }
  ],
  "timezone": "America/Denver",
  "minimumReleaseAge": "1 day",
  "prHourlyLimit": 30,
  "prConcurrentLimit": 30,
  "dependencyDashboard": {
    "enabled": true,
    "title": "Dependencies Dashboard 🤖"
  },
  "rangeStrategy": "replace",
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "conflicted",
  "platformAutomerge": false
}
