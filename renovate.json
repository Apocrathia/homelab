{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "security:openssf-scorecard",
    "docker:pinDigests"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "flux": {
    "enabled": true
  },
  "kubernetes": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchDatasources": ["python-version"],
      "enabled": false
    },
    {
      "matchCategories": ["docker"],
      "enabled": true
    },
    {
      "description": "One MR per digest pin/refresh — override default Pin Dependencies grouping",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": null
    },
    {
      "description": "No digest pins for version/tag/imageTag/helper_image fields — nowhere to attach @sha256",
      "matchDepTypes": ["version-field", "helper-image"],
      "pinDigests": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchPackageNames": ["ghcr.io/berriai/litellm-database"],
      "versioning": "semver"
    },
    {
      "description": "Calendar versioning (vYYYY.M.D.patch) — default semver can't parse these",
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "versioning": "calendar"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Renovate comment + image ref (bare, tag, digest, or tag@digest)",
      "managerFilePatterns": [
        "/^flux/manifests/.*\\.ya?ml$/",
        "/^\\.gitlab/.*\\.ya?ml$/"
      ],
      "depTypeTemplate": "image",
      "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}latest{{/if}}",
      "autoReplaceStringTemplate": "{{#if currentDigest}}{{{replace currentDigest newDigest (replace currentValue newValue replaceString)}}}{{else}}{{#if (containsString replaceString currentValue)}}{{{replace currentValue newValue replaceString}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{else}}{{{replaceString}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{/if}}{{/if}}",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n(?<indentation>[ \\t]*)(?:image|imageName|baseImage|ateomImage):[ \\t]*[\"']?(?:[^\\s\"'@:]+(?:/[^\\s\"'@:]+)*)(?::(?<currentValue>[^\\s\"'@/]+))?(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?",
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n(?<indentation>[ \\t]*)name:[ \\t]*[\"']?(?:[^\\s\"'@:]+/[^\\s\"'@:]+(?:/[^\\s\"'@:]+)*)(?::(?<currentValue>[^\\s\"'@/]+))?(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Renovate comment + plain version (yaml/CI/shell/env-list) or GitHub URL",
      "managerFilePatterns": [
        "/^flux/manifests/.*\\.ya?ml$/",
        "/^\\.gitlab/.*\\.ya?ml$/"
      ],
      "depTypeTemplate": "version-field",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:- name:\\s+\\S+\\s*\\n\\s+value:\\s*|(?:version|tag|imageTag):\\s*|[A-Z][A-Z0-9_]*[:=]\\s*|[A-Za-z_][\\w.-]*\\s*=\\s*)[\"']?(?<currentValue>[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?",
        "# renovate: datasource=(?<datasource>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: depName=(?<depName>\\S+))?(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*-?\\s*https://(?:github\\.com/[^/]+/[^/]+/releases/download/v|raw\\.githubusercontent\\.com/[^/]+/[^/]+/)(?<currentValue>[^/\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Talos Linux dependencies",
      "managerFilePatterns": ["/^talos/.*\\.yaml$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": [
        "# renovate: datasource=github-releases depName=(?<depName>siderolabs/talos)\\s*\\n\\s*image: .*:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "description": "generic-app Chart versions from Git tags",
      "managerFilePatterns": ["/^flux/manifests/.*\\.yaml$/"],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "https://gitlab.com/Apocrathia/homelab.git",
      "matchStrings": [
        "# renovate: datasource=git-tags depName=https://gitlab.com/Apocrathia/homelab.git\\s*\\n\\s*version: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "extractVersionTemplate": "^generic-app-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "GitLab Runner helper image in config.toml",
      "managerFilePatterns": [
        "/^flux/manifests/03-services/gitlab/runner/config\\.toml$/"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "helper-image",
      "matchStrings": [
        "# renovate: datasource=docker (?:registryUrl=(?<registryUrl>\\S+) )?depName=(?<depName>\\S+)\\s*\\n\\s*helper_image = [\"'](?:[^:]+:)?(?<currentValue>x86_64-v[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']"
      ],
      "extractVersionTemplate": "^x86_64-v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Docker images in GitLab Runner config.toml",
      "managerFilePatterns": [
        "/^flux/manifests/03-services/gitlab/runner/config\\.toml$/"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image",
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s*\\n\\s*image = [\"'](?:[^:]+):(?<currentValue>[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?[\"']"
      ]
    }
  ],
  "timezone": "America/Denver",
  "prHourlyLimit": 100,
  "prConcurrentLimit": 100,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependencies Dashboard 🤖",
  "rangeStrategy": "replace",
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "automergeType": "pr"
}
