# OpenTofu provider tokens — real values live in 1Password (gitignored).
# Non-secret org/zone/endpoint identity lives in provider or deployment HCL.
#
# All provider stacks (GitLab / Cloudflare / Okta / Proxmox): Connect auth.
#   export OP_CONNECT_HOST=http://onepassword-connect.onepassword-system.svc:8080
#   export OP_CONNECT_TOKEN=
# Local laptop: port-forward that Service (or use NodePort) — cluster DNS won't resolve.
#
# Items (vault Secrets, API Credential → credential field):
#   gitlab-terraform-secrets
#   cloudflare-terraform-secrets
#   okta-terraform-secrets
#   proxmox-terraform-secrets
