{
	// Declare static groups of users. Use autogroups for all users or users with a specific role.
	// "groups": {
	//  	"group:example": ["alice@example.com", "bob@example.com"],
	// },

	// Invited tailnet users (friends). The owner is a placeholder member
	// so the group is never empty (server-side validation of empty groups
	// is undocumented; a failed first CI apply is worse than a redundant
	// member whose admin grants already supersede this group). Replace
	// with the first friend's email when inviting (slice 3).
	"groups": {
		"group:friends": ["ian@apocrathia.com"],
	},

	// Define the tags which can be applied to devices and by which users.
	// tagOwners controls who can assign each tag. The k8s operator OAuth client
	// must be owner of tag:k8s-operator; the operator assigns tag:k8s to proxy pods.
	"tagOwners": {
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
	},

	// autoApprovers lets tagged devices approve certain requests without manual
	// admin approval. "services" covers Tailscale Services (used by ProxyGroup / HA
	// ingress). "exitNode" lets tag:k8s proxy pods advertise as exit nodes without
	// per-device approval (the exit-nodes ProxyGroup recreates pods on reschedule).
	"autoApprovers": {
		"services": {
			"tag:k8s": ["tag:k8s"],
		},
		"exitNode": ["tag:k8s"],
	},

	// Define grants that govern access for users, groups, autogroups, tags,
	// Tailscale IP addresses, and subnet ranges.
	//
	// Deny-by-default: there is no blanket grant. Every entry below is an
	// explicit exception; anything not listed here is blocked.
	"grants": [
		// Invited friends (group:friends) reach the tailnet front door
		// (tailnet-gateway, *.gateway.services.apocrathia.com) over HTTPS
		// and the split-DNS resolver (tailnet-dns device, also tag:k8s)
		// over DNS. Community reports say split-DNS servers are exempt
		// from grants, but docs only promise that for global nameservers,
		// so tcp/udp:53 is granted explicitly. Friends get NO exit-node or
		// internet access: the only autogroup:internet grant below is
		// admin-only, and nothing else references group:friends.
		{
			"src": ["group:friends"],
			"dst": ["tag:k8s"],
			"ip":  ["tcp:443", "tcp:53", "udp:53"],
		},

		// Tailnet admins keep the same HTTPS-only access to the front door
		// so the operator can reach and verify the service friends are
		// invited to. Port 53 was added with the split-DNS resolver: admin
		// devices resolve gateway.services.apocrathia.com through it too,
		// and the grants-exemption for split-DNS servers is unverified.
		// Remove this grant if no human access is wanted.
		{
			"src": ["autogroup:admin"],
			"dst": ["tag:k8s"],
			"ip":  ["tcp:443", "tcp:53", "udp:53"],
		},

		// Exit nodes: only devices with autogroup:internet access can use an
		// exit node (policy-file syntax rule), and this tailnet is deny-by-
		// default — without this grant no device can use the exit-nodes
		// Connector even though it is auto-approved. Scoped to admins only;
		// group:friends (invited friends) must not route internet traffic
		// through the cluster.
		{
			"src": ["autogroup:admin"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},

		// Allow users in "group:example" to access "tag:example", but only from
		// devices that are running macOS and have enabled Tailscale client auto-updating.
		// {"src": ["group:example"], "dst": ["tag:example"], "ip": ["*"], "srcPosture":["posture:autoUpdateMac"]},
	],

	// Define postures that will be applied to all rules without any specific
	// srcPosture definition.
	// "defaultSrcPosture": [
	//      "posture:anyMac",
	// ],

	// Define device posture rules requiring devices to meet
	// certain criteria to access parts of your system.
	// "postures": {
	//      // Require devices running macOS, a stable Tailscale
	//      // version and auto update enabled for Tailscale.
	// 	"posture:autoUpdateMac": [
	// 	    "node:os == 'macos'",
	// 	    "node:tsReleaseTrack == 'stable'",
	// 	    "node:tsAutoUpdate",
	// 	],
	//      // Require devices running macOS and a stable
	//      // Tailscale version.
	// 	"posture:anyMac": [
	// 	    "node:os == 'macos'",
	// 	    "node:tsReleaseTrack == 'stable'",
	// 	],
	// },

	// nodeAttrs grant capabilities to tagged devices. "funnel" lets tag:k8s
	// proxy pods expose services to the public internet via Tailscale Funnel.
	"nodeAttrs": [
		{
			"target": ["tag:k8s"],
			"attr":   ["funnel"],
		},
		{"target": ["*"], "app": {"tailscale.com/app-connectors": [{
			"name":        "github",
			"connectors":  ["tag:k8s-operator"],
			"presetAppID": "github",
		}]}},
	],

	// Tailscale SSH is intentionally not configured. The previous
	// autogroup:member -> autogroup:self check-mode rule was removed with the
	// move to deny-by-default; nothing on the tailnet uses SSH. Re-add an
	// explicit "ssh" block here if that ever changes.

	// Test access rules every time they're saved.
	"tests": [
		// Owner (implicitly admin) reaches the front door over HTTPS and the
		// split-DNS resolver over DNS; everything else stays denied.
		{
			"src":    "ian@apocrathia.com",
			"accept": ["tag:k8s:443", "tag:k8s:53"],
			"deny":   ["tag:k8s:22", "tag:k8s-operator:443"],
		},
		// autogroup:internet is rejected as a test dst, so exit-node access
		// cannot be asserted here (apply failed with "test(s) failed (400)"
		// when tried in !4387).
		//
		// group:friends IS a valid test src (policy-file syntax allows user,
		// group, tag, host), but the group is empty until slice 3 invites
		// land and the API needs a representative member. Uncomment with the
		// first invite:
		// {
		// 	"src":    "group:friends",
		// 	"accept": ["tag:k8s:443", "tag:k8s:53"],
		// 	"deny":   ["tag:k8s:22", "tag:k8s:8080"],
		// },
		// Friends' lack of internet access is structural (no
		// group:friends -> autogroup:internet grant exists) and cannot be
		// asserted here because autogroup:internet is not a valid test dst.
	],
}
