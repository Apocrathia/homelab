# Managed by Ansible (roles/common, network tag) - do not edit.
{% for iface in common_network_interfaces %}
auto {{ iface.device }}
iface {{ iface.device }} inet {{ 'manual' if iface.address is not defined else 'static' }}
{% if iface.vlan is defined %}
    vlan-raw-device {{ iface.device.split('.')[0] }}
{% endif %}
{% if iface.address is defined %}
    address {{ iface.address }}
{% endif %}
{% if iface.gateway is defined %}
    gateway {{ iface.gateway }}
{% endif %}

{% endfor %}
