# {{ nginx_site_domain }} — reverse proxy to {{ nginx_site_upstream }}.
# Cert: /etc/ssl/ansible/{{ nginx_site_domain }}.pem (minted/renewed by
# nickjj.acme_sh via Cloudflare DNS-01; reloadcmd reloads nginx).
server {
    listen 80;
    listen [::]:80;

    server_name {{ nginx_site_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name {{ nginx_site_domain }};

    ssl_certificate {{ nginx_site_tls_dir }}/{{ nginx_site_domain }}.pem;
    ssl_certificate_key {{ nginx_site_tls_dir }}/{{ nginx_site_domain }}.key;

    location / {
        proxy_pass http://{{ nginx_site_upstream }};
        proxy_set_header        Host $host;
        proxy_set_header        X-Real-IP $remote_addr;
        proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
{% if nginx_site_websockets %}
        proxy_set_header        Upgrade $http_upgrade;
        proxy_set_header        Connection "Upgrade";
{% endif %}
{% if nginx_site_extra_headers != "" %}
{{ nginx_site_extra_headers }}
{% endif %}
        proxy_read_timeout      86400s;
        proxy_send_timeout      86400s;
        proxy_http_version      1.1;
        proxy_redirect          off;
        proxy_buffering         off;
        client_max_body_size    10240M;
{% if nginx_site_shared_webroot != "" %}

        # Same-host app error page (AMP pattern: only correct when nginx and
        # the app share the host)
        error_page 502 /NotRunning.html;
        location = /NotRunning.html {
            root {{ nginx_site_shared_webroot }};
            internal;
        }

        location /shared/ {
            alias {{ nginx_site_shared_webroot }}/;
        }
{% endif %}
{% if nginx_site_extra_locations != "" %}

{{ nginx_site_extra_locations }}
{% endif %}
    }
}
